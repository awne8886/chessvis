+    pub(super) fn update(out: &mut [i16; H], src: &[i16; H], a0: &[i16], s0: &[i16], a1: Option<&[i16]>, s1: Option<&[i16]>) {
+        let (a0, s0) = (&a0[..H], &s0[..H]);
+        match (a1, s1) {
+            (None, None) => {
