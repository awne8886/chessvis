+                for i in (0..H).step_by(8) {
+                    st(out, i, i16x8_sub(i16x8_sub(i16x8_add(ld(src, i), ld(a0, i)), ld(s0, i)), ld(s1, i)));
+                }
+            }
+            (Some(a1), Some(s1)) => {
