{
  "manifest_version": 2,
  "name": "ChessVision",
  "version": "1.2.0",
  "description": "Auto-plays chess against bots using local Stockfish or the Tal-style AggroChess engine.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chessvision@awne8886",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage", "*://*.chess.com/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["*://*.chess.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "ChessVision",
    "default_popup": "popup.html"
  },
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; object-src 'self'"
}
