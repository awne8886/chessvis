{
  "manifest_version": 2,
  "name": "ChessVision",
  "version": "2.0.5",
  "description": "Auto-plays chess against chess.com bots using local Stockfish or the Tal-style AggroChess engine, with an on-page control panel.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chessvision@awne8886",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "*://*.chess.com/*",
    "*://*.chesscomfiles.com/*"
  ],
  "background": {
    "scripts": [
      "settings.js",
      "chessmini.js",
      "ponderstats.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chess.com/*"
      ],
      "js": [
        "settings.js",
        "chessmini.js",
        "humanize.js",
        "boardstate.js",
        "clock.js",
        "pgn.js",
        "brilliant.js",
        "recorder.js",
        "overlay.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "ChessVision",
    "default_popup": "popup.html"
  },
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; object-src 'self'"
}
